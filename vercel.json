{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "fix/quote-mission-payment-integrity": false,
      "feat/phase8-readiness": false,
      "feat/homepage-clarity": false
    }
  },
  "buildCommand": "bash scripts/vercel_build.sh",
  "outputDirectory": "build/web",
  "rewrites": [
    {
      "source": "/",
      "destination": "/seo/fr.html"
    },
    {
      "source": "/fr",
      "destination": "/seo/fr.html"
    },
    {
      "source": "/en",
      "destination": "/seo/en.html"
    },
    {
      "source": "/es",
      "destination": "/seo/es.html"
    },
    {
      "source": "/fr/livraison",
      "destination": "/seo/fr/livraison.html"
    },
    {
      "source": "/en/delivery",
      "destination": "/seo/en/delivery.html"
    },
    {
      "source": "/es/entrega",
      "destination": "/seo/es/entrega.html"
    },
    {
      "source": "/fr/tarifs",
      "destination": "/seo/fr/tarifs.html"
    },
    {
      "source": "/en/pricing",
      "destination": "/seo/en/pricing.html"
    },
    {
      "source": "/es/precios",
      "destination": "/seo/es/precios.html"
    },
    {
      "source": "/fr/comment-ca-marche",
      "destination": "/seo/fr/comment-ca-marche.html"
    },
    {
      "source": "/en/how-it-works",
      "destination": "/seo/en/how-it-works.html"
    },
    {
      "source": "/es/como-funciona",
      "destination": "/seo/es/como-funciona.html"
    },
    {
      "source": "/fr/securite",
      "destination": "/seo/fr/securite.html"
    },
    {
      "source": "/en/safety",
      "destination": "/seo/en/safety.html"
    },
    {
      "source": "/es/seguridad",
      "destination": "/seo/es/seguridad.html"
    },
    {
      "source": "/fr/faq",
      "destination": "/seo/fr/faq.html"
    },
    {
      "source": "/en/faq",
      "destination": "/seo/en/faq.html"
    },
    {
      "source": "/es/faq",
      "destination": "/seo/es/faq.html"
    },
    {
      "source": "/fr/granby",
      "destination": "/seo/fr/granby.html"
    },
    {
      "source": "/en/granby",
      "destination": "/seo/en/granby.html"
    },
    {
      "source": "/es/granby",
      "destination": "/seo/es/granby.html"
    },
    {
      "source": "/fr/devenir-chauffeur",
      "destination": "/seo/fr/devenir-chauffeur.html"
    },
    {
      "source": "/en/become-driver",
      "destination": "/seo/en/become-driver.html"
    },
    {
      "source": "/es/convertirse-conductor",
      "destination": "/seo/es/convertirse-conductor.html"
    },
    {
      "source": "/fr/a-propos",
      "destination": "/seo/fr/a-propos.html"
    },
    {
      "source": "/en/about",
      "destination": "/seo/en/about.html"
    },
    {
      "source": "/es/acerca-de",
      "destination": "/seo/es/acerca-de.html"
    },
    {
      "source": "/fr/contact",
      "destination": "/seo/fr/contact.html"
    },
    {
      "source": "/en/contact",
      "destination": "/seo/en/contact.html"
    },
    {
      "source": "/es/contacto",
      "destination": "/seo/es/contacto.html"
    },
    {
      "source": "/:locale(fr|en|es)",
      "destination": "/index.html"
    },
    {
      "source": "/:locale(fr|en|es)/:page(granby|livraison|delivery|entrega|mecanique-mobile|mobile-mechanic|mecanico-movil|devenir-chauffeur|become-driver|convertirse-conductor|devenir-mecanicien|become-mechanic|convertirse-mecanico|connexion|sign-in|iniciar-sesion|tarifs|pricing|precios|comment-ca-marche|how-it-works|como-funciona|securite|safety|seguridad|faq|a-propos|about|acerca-de|contact|contacto|blogue|blog|notifications|tableau-de-bord|dashboard|panel|admin)",
      "destination": "/index.html"
    },
    {
      "source": "/:locale(fr|en|es)/livraison/demande",
      "destination": "/index.html"
    },
    {
      "source": "/:locale(fr|en|es)/delivery/request",
      "destination": "/index.html"
    },
    {
      "source": "/:locale(fr|en|es)/entrega/solicitud",
      "destination": "/index.html"
    },
    {
      "source": "/:locale(fr|en|es)/mecanique-mobile/demande",
      "destination": "/index.html"
    },
    {
      "source": "/:locale(fr|en|es)/mobile-mechanic/request",
      "destination": "/index.html"
    },
    {
      "source": "/:locale(fr|en|es)/mecanico-movil/solicitud",
      "destination": "/index.html"
    },
    {
      "source": "/:locale(fr|en|es)/devenir-chauffeur/inscription",
      "destination": "/index.html"
    },
    {
      "source": "/:locale(fr|en|es)/become-driver/onboarding",
      "destination": "/index.html"
    },
    {
      "source": "/:locale(fr|en|es)/devenir-chauffeur/statut",
      "destination": "/index.html"
    },
    {
      "source": "/:locale(fr|en|es)/become-driver/status",
      "destination": "/index.html"
    },
    {
      "source": "/:locale(fr|en|es)/convertirse-conductor/estado",
      "destination": "/index.html"
    },
    {
      "source": "/:locale(fr|en|es)/devenir-mecanicien/inscription",
      "destination": "/index.html"
    },
    {
      "source": "/:locale(fr|en|es)/become-mechanic/onboarding",
      "destination": "/index.html"
    },
    {
      "source": "/:locale(fr|en|es)/fournisseur/tableau-de-bord",
      "destination": "/index.html"
    },
    {
      "source": "/:locale(fr|en|es)/provider/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/:locale(fr|en|es)/chauffeur/onboarding/complete",
      "destination": "/index.html"
    },
    {
      "source": "/:locale(fr|en|es)/driver/onboarding/complete",
      "destination": "/index.html"
    },
    {
      "source": "/:locale(fr|en|es)/conductor/incorporacion/completado",
      "destination": "/index.html"
    },
    {
      "source": "/:locale(fr|en|es)/chauffeur/onboarding/refresh",
      "destination": "/index.html"
    },
    {
      "source": "/:locale(fr|en|es)/driver/onboarding/refresh",
      "destination": "/index.html"
    },
    {
      "source": "/:locale(fr|en|es)/conductor/incorporacion/reintentar",
      "destination": "/index.html"
    },
    {
      "source": "/:locale(fr|en|es)/admin/chauffeurs",
      "destination": "/index.html"
    },
    {
      "source": "/:locale(fr|en|es)/admin/utilisateurs",
      "destination": "/index.html"
    },
    {
      "source": "/:locale(fr|en|es)/admin/missions",
      "destination": "/index.html"
    },
    {
      "source": "/:locale(fr|en|es)/admin/pilote",
      "destination": "/index.html"
    },
    {
      "source": "/:locale(fr|en|es)/admin/centre-commande",
      "destination": "/index.html"
    },
    {
      "source": "/:locale(fr|en|es)/admin/types-objets",
      "destination": "/index.html"
    },
    {
      "source": "/:locale(fr|en|es)/admin/paiements",
      "destination": "/index.html"
    },
    {
      "source": "/:locale(fr|en|es)/admin/conditions",
      "destination": "/index.html"
    },
    {
      "source": "/:locale(fr|en|es)/legal/:type(terms|privacy|cancellation|dispute|accessibility|cookies|provider-agreement)",
      "destination": "/index.html"
    },
    {
      "source": "/:locale(fr|en|es)/livraison/conditions/:missionId",
      "destination": "/index.html"
    },
    {
      "source": "/:locale(fr|en|es)/livraison/suivi/:missionId",
      "destination": "/index.html"
    },
    {
      "source": "/:locale(fr|en|es)/delivery/track/:missionId",
      "destination": "/index.html"
    },
    {
      "source": "/:locale(fr|en|es)/entrega/seguimiento/:missionId",
      "destination": "/index.html"
    },
    {
      "source": "/:locale(fr|en|es)/fournisseur/mission/:missionId",
      "destination": "/index.html"
    },
    {
      "source": "/:locale(fr|en|es)/provider/mission/:missionId",
      "destination": "/index.html"
    },
    {
      "source": "/:locale(fr|en|es)/admin/chauffeurs/:driverId",
      "destination": "/index.html"
    },
    {
      "source": "/:locale(fr|en|es)/admin/utilisateurs/:userId",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), geolocation=(self), microphone=(), payment=(self \"https://checkout.stripe.com\")"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        }
      ]
    }
  ]
}
