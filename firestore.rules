rules_version = '2';

// =============================================================================
// Movi-K — Firestore Security Rules (Étape 9)
//
// PRINCIPE : DENY BY DEFAULT.
// Rien n'est lisible ni écrivable sans une règle explicite ci-dessous.
// La règle finale du fichier bloque tout le reste.
//
// RÔLES : lus EXCLUSIVEMENT depuis les Firebase Auth Custom Claims
// (request.auth.token.role / request.auth.token.roles), JAMAIS depuis un
// champ Firestore (users/{uid}.roles n'est qu'un miroir d'affichage et
// n'est jamais utilisé ici pour autoriser une action).
//
// Voir docs/FIRESTORE_ARCHITECTURE.md pour le schéma complet et la
// justification de chaque règle.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------
    // Helpers
    // -------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Rôle principal, injecté comme custom claim au login (ex: 'driver').
    function role() {
      return isSignedIn() ? request.auth.token.role : null;
    }

    // Certains comptes peuvent cumuler plusieurs rôles (ex: customer + driver).
    // roles est un tableau de custom claim, fallback sur [role()] si absent.
    function roles() {
      return isSignedIn()
        ? (('roles' in request.auth.token) ? request.auth.token.roles : [request.auth.token.role])
        : [];
    }

    function hasRole(r) {
      return isSignedIn() && r in roles();
    }

    function isAnalystOrAbove() {
      return hasRole('analyst') || hasRole('admin') || hasRole('super_admin');
    }

    function isAdminOrAbove() {
      return hasRole('admin') || hasRole('super_admin');
    }

    function isSuperAdmin() {
      return hasRole('super_admin');
    }

    function isDriver() {
      return hasRole('driver');
    }

    function isCustomer() {
      return hasRole('customer');
    }

    // Un chauffeur "approuvé" est déterminé UNIQUEMENT en lisant son propre
    // document driver_profiles (jamais un claim, ce statut évolue trop
    // souvent et doit rester server-authoritative dans Firestore).
    function isApprovedDriver(driverId) {
      return exists(/databases/$(database)/documents/driver_profiles/$(driverId)) &&
        get(/databases/$(database)/documents/driver_profiles/$(driverId)).data.status == 'approved';
    }

    // -------------------------------------------------------------------
    // users/{userId}
    // -------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn() && (uid() == userId || isAnalystOrAbove());

      // Le propriétaire peut modifier ses champs déclaratifs, JAMAIS `roles`,
      // `uid`, `created_at`, `is_disabled`, `email_verified`.
      allow update: if isSignedIn() && uid() == userId &&
        request.resource.data.roles == resource.data.roles &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.created_at == resource.data.created_at &&
        request.resource.data.is_disabled == resource.data.is_disabled &&
        request.resource.data.email_verified == resource.data.email_verified;

      // Création initiale du profil (ex: juste après inscription) — rôle
      // forcé à ['customer'] uniquement ; toute élévation passe ensuite par
      // la Cloud Function setUserRole() (jamais par ce create).
      allow create: if isSignedIn() && uid() == userId &&
        request.resource.data.uid == userId &&
        request.resource.data.roles == ['customer'];

      // 🔒 roles: Cloud Functions only (setUserRole). Aucune règle 'update'
      // ci-dessus n'autorise un changement de roles — la contrainte
      // request.resource.data.roles == resource.data.roles le garantit.
      allow delete: if false;
    }

    // -------------------------------------------------------------------
    // driver_profiles/{driverId}
    // -------------------------------------------------------------------
    match /driver_profiles/{driverId} {
      allow read: if isSignedIn() && (uid() == driverId || isAnalystOrAbove());
      // Un client NE PEUT PAS lire directement le profil d'un autre
      // chauffeur : il voit uniquement la vue dénormalisée
      // (driver_display_name) copiée dans sa propre mission.

      // SEC-S2 (2026-10-22) — LISTE BLANCHE. Le chauffeur n'écrit que ses
      // champs DÉCLARATIFS. Tout le reste (statut, vérifications, compte
      // Stripe de versement, notes, compteurs, suspension…) est réservé aux
      // Cloud Functions. Avant ce correctif, l'update comparait une liste
      // de champs protégés : les champs Stripe (stripe_connected_account_id,
      // stripe_payouts_enabled…) n'y figuraient pas, si bien qu'un chauffeur
      // pouvait rediriger ses propres versements; et la création ne
      // vérifiait que `status`, permettant de s'auto-déclarer
      // documents_all_valid / identity_verified.
      function driverDeclaredFields() {
        return ['full_name', 'city', 'phone',
                'base_address_formatted', 'base_address_line1', 'base_region',
                'base_postal_code', 'base_country', 'base_place_id',
                'base_lat', 'base_lng',
                'spoken_languages', 'loading_assistance_available',
                'service_radius_km', 'accepted_vehicle_categories',
                'accepted_item_category_keys', 'max_loading_team_size'];
      }

      // Équipe de chargement déclarée : 1 (chauffeur seul) à 5 personnes.
      function validTeamSize(data) {
        return !('max_loading_team_size' in data) ||
          (data.max_loading_team_size is int &&
           data.max_loading_team_size >= 1 && data.max_loading_team_size <= 5);
      }

      allow create: if isSignedIn() && uid() == driverId && isDriver() &&
        request.resource.data.status == 'registration_incomplete' &&
        request.resource.data.get('uid', driverId) == driverId &&
        request.resource.data.get('online_status', 'offline') == 'offline' &&
        request.resource.data.keys().hasOnly(
          driverDeclaredFields().concat(['uid', 'status', 'online_status', 'created_at'])) &&
        validTeamSize(request.resource.data);

      allow update: if isSignedIn() && uid() == driverId && isDriver() && (
        // Champs déclaratifs (formulaire d'inscription / profil).
        (request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(driverDeclaredFields()) &&
         validTeamSize(request.resource.data)) ||
        // Disponibilité : passer « online » exige d'être approuvé (empêche un
        // non-approuvé d'entrer dans le dispatch); se mettre « offline » est
        // toujours permis (déconnexion, suspension).
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['online_status']) &&
         (request.resource.data.online_status == 'offline' ||
          (request.resource.data.online_status == 'online' && resource.data.status == 'approved')))
      );

      // 🔒 Les champs sensibles (status, approved_at, approved_by_user_id,
      // rejection_reason, identity_verified, vehicle_verified, rating,
      // completed_missions, documents_all_valid, current_geohash,
      // documents_required_*, suspended_*, suspension_reason, suspension_mode,
      // reactivated_*)
      // ne sont JAMAIS modifiables par un client, y compris analyst/admin :
      // ils passent exclusivement par les Cloud Functions approveDriver() /
      // rejectDriver() / requestDriverDocuments() / suspendDriver() /
      // reactivateDriver() (qui s'exécutent avec les privilèges Admin SDK
      // côté serveur, hors du chemin des Security Rules client). Aucune
      // règle "allow update: if isAnalystOrAbove()" n'existe donc ici
      // volontairement — le portail analyste n'écrit jamais Firestore
      // directement, il appelle toujours une Cloud Function callable.

      allow delete: if false;
    }

    // -------------------------------------------------------------------
    // driver_documents/{documentId}
    // -------------------------------------------------------------------
    match /driver_documents/{documentId} {
      allow read: if isSignedIn() &&
        (resource.data.driver_id == uid() || isAnalystOrAbove());

      // Le chauffeur peut créer un document en statut 'uploaded' uniquement.
      allow create: if isSignedIn() && isDriver() &&
        request.resource.data.driver_id == uid() &&
        request.resource.data.status == 'uploaded';

      // 🔒 Le changement de `status` (approved/rejected/replacement_required)
      // est exclusivement Cloud Functions only (validateDriverDocument(),
      // appelée par un analyste authentifié — la fonction vérifie le rôle
      // puis écrit avec les privilèges Admin SDK et journalise dans
      // audit_logs). Aucune règle client, même analyst/admin, n'autorise
      // ici de update direct.
      allow update: if false;

      allow delete: if false;
    }

    // -------------------------------------------------------------------
    // driver_vehicles/{vehicleId}
    // -------------------------------------------------------------------
    match /driver_vehicles/{vehicleId} {
      allow read: if isSignedIn() &&
        (resource.data.driver_id == uid() || isAnalystOrAbove());

      allow create: if isSignedIn() && isDriver() &&
        request.resource.data.driver_id == uid() &&
        request.resource.data.is_verified == false &&
        !request.resource.data.keys().hasAny(['verified_capacity', 'capacity_valid_until', 'verified_identity', 'capacity_reviewed_at', 'capacity_reviewed_by', 'capacity_review_note']);

      allow update: if isSignedIn() && (
        (resource.data.driver_id == uid() &&
         request.resource.data.driver_id == resource.data.driver_id &&
         request.resource.data.is_verified == resource.data.is_verified &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified_capacity', 'capacity_valid_until', 'verified_identity', 'capacity_reviewed_at', 'capacity_reviewed_by', 'capacity_review_note']) &&
         (resource.data.is_verified != true || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['category', 'make_model', 'year', 'plate', 'max_payload_kg']))) ||
        isAnalystOrAbove()
      );

      allow delete: if resource.data.driver_id == uid() && isDriver();
    }

    // -------------------------------------------------------------------
    // driver_internal_notes/{noteId} — notes internes analyste/admin
    // (Phase 2 — portail analyste). JAMAIS visibles au chauffeur concerné.
    // Immuables après création (même pattern que audit_logs) : aucune
    // règle update/delete n'est exposée, pour qu'une note ne puisse jamais
    // être supprimée silencieusement. Écriture exclusivement via la Cloud
    // Function addDriverInternalNote() (garantit author_user_id/author_role
    // non falsifiables).
    // -------------------------------------------------------------------
    match /driver_internal_notes/{noteId} {
      allow read: if isAnalystOrAbove();
      allow write: if false; // 🔒 Cloud Functions only (addDriverInternalNote).
    }

    // -------------------------------------------------------------------
    // driver_locations/{driverId} — position actuelle
    // -------------------------------------------------------------------
    match /driver_locations/{driverId} {
      allow read: if isSignedIn() && (
        uid() == driverId ||
        isAnalystOrAbove() ||
        // Client : uniquement s'il a une mission active avec CE chauffeur.
        (isCustomer() &&
         resource.data.active_delivery_id != null &&
         exists(/databases/$(database)/documents/delivery_requests/$(resource.data.active_delivery_id)) &&
         get(/databases/$(database)/documents/delivery_requests/$(resource.data.active_delivery_id)).data.customer_id == uid() &&
         get(/databases/$(database)/documents/delivery_requests/$(resource.data.active_delivery_id)).data.driver_id == driverId &&
         // R-K-03-A : une mission terminale ne donne plus accès à la position
         // courante, même avant le nettoyage asynchrone du lien actif.
         get(/databases/$(database)/documents/delivery_requests/$(resource.data.active_delivery_id)).data.status in [
           'assigned', 'driver_to_pickup', 'arrived_at_pickup',
           'picked_up', 'in_transit', 'arrived_at_dropoff'
         ])
      );

      // R-K-03-A : position et lien actif sont écrits exclusivement côté serveur.
      // Flutter appelle recordTrackingPoint ; assignation et nettoyage utilisent
      // l’Admin SDK. Aucun client ne peut forger/supprimer active_delivery_id.
      allow write: if false;

      match /history/{eventId} {
        allow read: if isSignedIn() && (
          uid() == driverId ||
          isAnalystOrAbove() ||
          (isCustomer() &&
           exists(/databases/$(database)/documents/delivery_requests/$(resource.data.delivery_id)) &&
           get(/databases/$(database)/documents/delivery_requests/$(resource.data.delivery_id)).data.customer_id == uid())
        );
        // 🔒 Cloud Functions only (recordTrackingPoint).
        allow write: if false;
      }
    }

    // -------------------------------------------------------------------
    // delivery_requests/{missionId}
    // -------------------------------------------------------------------
    match /delivery_requests/{missionId} {
      allow read: if isSignedIn() && (
        resource.data.customer_id == uid() ||
        resource.data.driver_id == uid() ||
        isAnalystOrAbove() ||
        // Chauffeur approuvé peut voir les missions ouvertes de sa
        // catégorie/zone (le filtrage précis se fait côté requête + index,
        // la règle vérifie seulement que la mission est bien "ouverte").
        (isDriver() && isApprovedDriver(uid()) &&
         resource.data.status in ['searching_driver', 'offered'] &&
         resource.data.get('offered_driver_ids', []).hasAny([uid()]) &&
         resource.data.get('offered_until', request.time) > request.time)
      );

      // Création directe désactivée : la création DOIT passer par la Cloud
      // Function createDeliveryRequest() pour garantir la cohérence avec un
      // devis (delivery_quotes) valide et non expiré.
      allow create: if false;

      // Le client peut modifier UNIQUEMENT des champs non sensibles tant
      // qu'aucun chauffeur n'est assigné, ou annuler après assignation.
      //
      // BUG-V-01 (Phase 7, Bloc V) — CORRECTIF : la branche "Annulation"
      // ci-dessous vérifiait uniquement le statut CIBLE
      // (request.resource.data.status == 'cancelled') sans jamais vérifier
      // le statut ACTUEL (resource.data.status). Un client propriétaire
      // pouvait donc annuler directement une mission déjà 'completed'
      // (ou déjà 'cancelled'/'disputed'/'refunded'), rouvrant à tort un état
      // terminal — violation de la règle métier "completed/cancelled restent
      // terminaux" (voir V-8). CORRIGÉ en exigeant explicitement que le
      // statut ACTUEL soit encore actif (jamais déjà terminal) avant
      // d'autoriser la transition vers 'cancelled'.
      allow update: if isSignedIn() &&
        resource.data.customer_id == uid() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'scheduling', 'schedule_state', 'acceptance_request_id', 'duration_confirmation', 'dispatch_candidate_cursor', 'acceptance_fingerprint', 'dispatch_round', 'dispatch_state', 'dispatch_next_attempt_at', 'dispatch_candidates_limited', 'offered_driver_ids', 'offered_until', 'requested_at',
          'booking_snapshot', 'assigned_vehicle_id', 'assigned_capacity_version', 'requested_time_status',
          'assignment_mode',
          'internal_test_authorized',
          'internal_test_assigned_by',
          'internal_test_assigned_at',
          'active_quote_id',
          'active_financial_snapshot_id',
          'active_payment_id',
          'pricing_version',
          'pricing_snapshot',
          'quote_breakdown',
          'quote_integrity_hash',
          'quote_schema_version',
          'customer_total',
          'customer_total_minor',
          'customer_discount_amount',
          'tax_snapshot',
          'distance_km',
          'estimated_duration_minutes',
          'required_vehicle_category',
          'pickup_address',
          'dropoff_address',
          'driver_offer_amount',
          'payment_status'
        ]) && (
        (resource.data.driver_id == null &&
         request.resource.data.driver_id == resource.data.driver_id &&
         request.resource.data.status == resource.data.status &&
         request.resource.data.driver_offer_amount == resource.data.driver_offer_amount &&
         request.resource.data.customer_total == resource.data.customer_total &&
         request.resource.data.payment_status == resource.data.payment_status &&
         request.resource.data.pricing_version == resource.data.pricing_version) ||
        // Annulation : seul le champ status -> 'cancelled' + cancellation_reason,
        // et UNIQUEMENT depuis un statut ACTUEL non terminal.
        // SEC-S1 (2026-10-22) : annulation client UNIQUEMENT avant le
        // ramassage. Une fois l'objet pris en charge (picked_up et après),
        // annuler libérait l'autorisation de carte alors que le chauffeur
        // avait déjà transporté l'objet. 'delivered' n'était pas non plus
        // exclu. Liste blanche explicite plutôt que liste noire.
        (request.resource.data.status == 'cancelled' &&
         resource.data.status in ['draft', 'quoted', 'searching_driver', 'offered',
                                  'assigned', 'driver_to_pickup', 'arrived_at_pickup',
                                  'payment_failed'] &&
         request.resource.data.driver_id == resource.data.driver_id &&
         request.resource.data.driver_offer_amount == resource.data.driver_offer_amount &&
         request.resource.data.customer_total == resource.data.customer_total &&
         request.resource.data.pricing_version == resource.data.pricing_version)
      );

      // 🔒 Toute écriture impliquant driver_id, status (hors annulation
      // client), accepted_at, driver_offer_amount, customer_total,
      // payment_status, completed_at est exclusivement Cloud Functions
      // only (acceptDelivery, completePickup, completeDelivery, etc.).
      // Aucune règle client, même analyst/admin, n'autorise ce chemin —
      // le portail analyste agit toujours via une Cloud Function callable
      // pour garantir l'audit_log et la cohérence transactionnelle.

      allow delete: if false;

      match /private/{documentId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/delivery_requests/$(missionId)).data.customer_id == uid() ||
          get(/databases/$(database)/documents/delivery_requests/$(missionId)).data.driver_id == uid() || isAnalystOrAbove());
        allow write: if false;
      }
      match /stops/{stopId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/delivery_requests/$(missionId)).data.customer_id == uid() ||
          get(/databases/$(database)/documents/delivery_requests/$(missionId)).data.driver_id == uid() ||
          isAnalystOrAbove()
        );
        // completed_at est 🔒 Cloud Functions only ; la création initiale
        // des arrêts se fait aussi via createDeliveryRequest().
        allow write: if false;
      }

      match /tracking_events/{eventId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/delivery_requests/$(missionId)).data.customer_id == uid() ||
          get(/databases/$(database)/documents/delivery_requests/$(missionId)).data.driver_id == uid() ||
          isAnalystOrAbove()
        );
        allow write: if false; // 🔒 Cloud Functions only.
      }
    }

    // -------------------------------------------------------------------
    // delivery_offers/{offerId}
    // -------------------------------------------------------------------
    match /delivery_offers/{offerId} {
      allow read: if isSignedIn() &&
        (resource.data.driver_id == uid() || isAnalystOrAbove());
      allow write: if false; // 🔒 Cloud Functions only (dispatch + acceptDelivery).
    }

    // -------------------------------------------------------------------
    // delivery_quotes/{quoteId}
    // -------------------------------------------------------------------
    match /delivery_quotes/{quoteId} {
      allow read: if isSignedIn() &&
        (resource.data.customer_id == uid() || isAnalystOrAbove());
      allow write: if false; // 🔒 Cloud Functions only (calculateDeliveryQuote).
    }

    // -------------------------------------------------------------------
    // pricing_configs/{singleton} & pricing_versions/{version}
    // -------------------------------------------------------------------
    match /pricing_configs/{docId} {
      allow read: if isSignedIn();
      allow write: if false; // 🔒 Cloud Functions only (updatePricingConfiguration).
    }

    match /pricing_versions/{version} {
      allow read: if isSignedIn();
      allow write: if false; // 🔒 Cloud Functions only, immuable une fois publiée.
    }

    // -------------------------------------------------------------------
    // promo_codes/{code} — codes promo client (montant JAMAIS accepté du
    // client ; calculateDeliveryQuote() lit ce document pour résoudre le
    // montant de remise réel côté serveur). Ajouté à l'étape 12 (tests
    // "customer promotion") — voir docs/FIRESTORE_ARCHITECTURE.md addendum.
    // -------------------------------------------------------------------
    match /promo_codes/{code} {
      // SEC-S5 (2026-10-22) : lecture d'UN code connu seulement (get), jamais
      // la liste complète. Le prix réel est toujours résolu côté serveur
      // (calculateDeliveryQuote); la liste exposait tous les codes actifs.
      allow get: if isSignedIn();
      allow list: if isAnalystOrAbove();
      allow write: if false; // 🔒 Cloud Functions only / admin console (hors scope étape 11).
    }

    // -------------------------------------------------------------------
    // driver_pricing_profiles/{driverId}
    // -------------------------------------------------------------------
    match /driver_pricing_profiles/{driverId} {
      allow read: if isSignedIn() && (uid() == driverId || isAnalystOrAbove());
      allow write: if false; // 🔒 Cloud Functions only (cache, recalculé serveur).
    }

    // -------------------------------------------------------------------
    // driver_promotions/{promoId}
    // -------------------------------------------------------------------
    match /driver_promotions/{promoId} {
      allow read: if isSignedIn() &&
        (resource.data.driver_id == uid() || isAnalystOrAbove());
      allow write: if false; // 🔒 Cloud Functions only (applyDriverPromotion).
    }

    // -------------------------------------------------------------------
    // founding_driver_programs/{programId}
    // -------------------------------------------------------------------
    match /founding_driver_programs/{programId} {
      allow read: if isSignedIn(); // config publique (places restantes, etc.)
      allow write: if false; // 🔒 Cloud Functions only.

      match /qualifications/{driverId} {
        allow read: if isSignedIn() && (uid() == driverId || isAnalystOrAbove());
        allow write: if false; // 🔒 qualifyFoundingDriver / revokeFoundingDriverStatus only.
      }
    }

    // -------------------------------------------------------------------
    // financial_snapshots/{id} — IMMUABLE, Cloud Functions only
    // -------------------------------------------------------------------
    match /financial_snapshots/{snapshotId} {
      allow read: if isSignedIn() && (
        resource.data.customer_id == uid() ||
        resource.data.driver_id == uid() ||
        isAnalystOrAbove()
      );
      // Aucune écriture cliente, jamais, quel que soit le rôle.
      allow write: if false;
    }

    // -------------------------------------------------------------------
    // transaction_ledger/{id} — APPEND-ONLY, Cloud Functions only
    // -------------------------------------------------------------------
    match /transaction_ledger/{entryId} {
      allow read: if isSignedIn() && (
        isAnalystOrAbove() ||
        (resource.data.party == 'customer' &&
         exists(/databases/$(database)/documents/delivery_requests/$(resource.data.mission_id)) &&
         get(/databases/$(database)/documents/delivery_requests/$(resource.data.mission_id)).data.customer_id == uid()) ||
        (resource.data.party == 'driver' &&
         exists(/databases/$(database)/documents/delivery_requests/$(resource.data.mission_id)) &&
         get(/databases/$(database)/documents/delivery_requests/$(resource.data.mission_id)).data.driver_id == uid())
      );
      // Aucune écriture cliente. Corrections = nouvelle entrée compensatoire
      // créée par Cloud Function, jamais un update/delete.
      allow write: if false;
    }

    // -------------------------------------------------------------------
    // payments/{id} & driver_payouts/{id} — Cloud Functions only
    // -------------------------------------------------------------------
    match /payments/{paymentId} {
      allow read: if isSignedIn() &&
        (resource.data.customer_id == uid() || isAnalystOrAbove());
      allow write: if false;
    }

    match /driver_payouts/{payoutId} {
      allow read: if isSignedIn() &&
        (resource.data.driver_id == uid() || isAnalystOrAbove());
      allow write: if false;
    }

    // -------------------------------------------------------------------
    // PHASE 6 — collections financières additionnelles, toutes
    // Cloud-Functions-only en écriture (le SDK Admin contourne les Rules ;
    // ces blocs ne servent qu'à scoper la LECTURE côté client / analyste,
    // suivant le même schéma que payments/driver_payouts ci-dessus).
    // -------------------------------------------------------------------

    // refunds/{id} — remboursements (points 19-20).
    match /refunds/{refundId} {
      // SEC-S6 (2026-10-22) : l'app client interroge les remboursements par
      // mission_id (mission_finance_section.dart). Une règle fondée
      // uniquement sur payment_id ne peut pas être prouvée par cette
      // requête et la refusait toujours. La lecture par paiement reste
      // permise; la lecture par mission vérifie la propriété de la mission.
      allow read: if isSignedIn() && (
        isAnalystOrAbove() ||
        (resource.data.get('mission_id', null) != null &&
         exists(/databases/$(database)/documents/delivery_requests/$(resource.data.mission_id)) &&
         get(/databases/$(database)/documents/delivery_requests/$(resource.data.mission_id)).data.customer_id == uid()) ||
        (exists(/databases/$(database)/documents/payments/$(resource.data.payment_id)) &&
         get(/databases/$(database)/documents/payments/$(resource.data.payment_id)).data.customer_id == uid())
      );
      allow write: if false;
    }

    // disputes/{id} — litiges / chargebacks (point 21).
    match /disputes/{disputeId} {
      allow read: if isSignedIn() && isAnalystOrAbove();
      allow write: if false;
    }

    // provider_webhook_events/{id} — évènements Stripe entrants (point 11).
    // Jamais lisible côté client, uniquement debug interne admin.
    match /provider_webhook_events/{eventId} {
      allow read: if isAdminOrAbove();
      allow write: if false;
    }

    // reconciliation_reports/{id} — moteur de réconciliation (point 27).
    match /reconciliation_reports/{reportId} {
      allow read: if isAdminOrAbove();
      allow write: if false;
    }

    // payment_profiles/{customerId} — référence Stripe client (aucune
    // donnée de carte sensible), lisible uniquement par son propriétaire.
    match /booking_attempts/{attemptId} { allow read, write: if false; }
    match /booking_photo_grants/{draftId} { allow read, write: if false; }
    match /booking_reviews/{reviewId} {
      allow read: if isSignedIn() && (resource.data.customer_id == uid() || isAnalystOrAbove());
      allow write: if false;
    }
    match /booking_drafts/{customerId} {
      allow read: if isSignedIn() && customerId == uid() && resource.data.expires_at > request.time;
      allow write: if false;
    }
    match /booking_payment_setups/{setupId} { allow read, write: if false; }
    match /payment_profiles/{customerId} {
      allow read: if isSignedIn() && (uid() == customerId || isAnalystOrAbove());
      allow write: if false;
    }

    // idempotency_keys/{key} — verrous internes, jamais exposés au client.
    match /idempotency_keys/{key} {
      allow read, write: if false;
    }

    // tax_configs/{jurisdiction} — moteur de taxes configurable (point 16).
    // Lecture publique (affichage de la ventilation des taxes côté client),
    // écriture Cloud-Functions-only (admin uniquement, via fonction dédiée).
    match /tax_configs/{jurisdiction} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // payout_policy_configs/{id} — politique de rétention des versements
    // chauffeur (point 9). Lecture réservée aux admins (paramètre interne,
    // pas d'affichage client), écriture via updatePayoutPolicyConfiguration
    // uniquement.
    match /payout_policy_configs/{configId} {
      allow read: if isAdminOrAbove();
      allow write: if false;
    }

    // system_config/{docId} — kill switches / feature flags MVP (Phase 7,
    // bloc X), notamment `runtime_flags` (accept_new_delivery_requests,
    // allow_driver_acceptance, payments_enabled, driver_payouts_enabled).
    // Paramètre interne serveur-autoritaire : lecture réservée aux admins
    // (pas d'affichage client), écriture STRICTEMENT via la Cloud Function
    // privilégiée updateRuntimeFlags — jamais directement par un client,
    // même admin (aucun bypass possible en modifiant l'app cliente).
    match /system_config/{docId} {
      allow read: if isAdminOrAbove();
      allow write: if false;
    }

    // mission_financial_balance/{missionId} — état financier dérivé du
    // ledger (point 7, directive 38 points). Lisible par le client et le
    // chauffeur de LEUR PROPRE mission (UI client/chauffeur, points 22/24),
    // et par analyst/admin/super_admin. Jamais écrit par le client — le
    // seul écrivain est recalculateMissionFinancialBalance() (SDK Admin).
    match /mission_financial_balance/{missionId} {
      allow read: if isSignedIn() && (
        isAnalystOrAbove() ||
        (exists(/databases/$(database)/documents/delivery_requests/$(missionId)) &&
         (get(/databases/$(database)/documents/delivery_requests/$(missionId)).data.customer_id == uid() ||
          get(/databases/$(database)/documents/delivery_requests/$(missionId)).data.driver_id == uid()))
      );
      allow write: if false;
    }

    // -------------------------------------------------------------------
    // ratings/{id}
    // -------------------------------------------------------------------

    // Foreground connectivity is separate from dispatch availability.
    match /mission_outcome_reviews/{missionId} {
      allow read: if isAnalystOrAbove();
      allow write: if false; // Callable admin + atomic audit only.
    }

    match /driver_presence/{sessionId} {
      allow read: if isAnalystOrAbove();
      allow create: if isDriver() &&
        exists(/databases/$(database)/documents/driver_profiles/$(uid())) &&
        request.resource.data.keys().hasOnly(['driver_id', 'updated_at']) &&
        request.resource.data.driver_id == uid() &&
        request.resource.data.updated_at == request.time;
      allow update: if isDriver() && resource.data.driver_id == uid() &&
        request.resource.data.keys().hasOnly(['driver_id', 'updated_at']) &&
        request.resource.data.driver_id == uid() &&
        request.resource.data.updated_at == request.time;
      allow delete: if isSignedIn() && resource.data.driver_id == uid();
    }

    match /ratings/{ratingId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() &&
        request.resource.data.rater_id == uid() &&
        ratingId == request.resource.data.mission_id + '_' + request.resource.data.rater_role &&
        request.resource.data.stars is int &&
        request.resource.data.created_at == request.time &&
        request.resource.data.stars >= 1 && request.resource.data.stars <= 5 &&
        exists(/databases/$(database)/documents/delivery_requests/$(request.resource.data.mission_id)) &&
        get(/databases/$(database)/documents/delivery_requests/$(request.resource.data.mission_id)).data.status == 'completed' &&
        (
          !('assignment_mode' in get(/databases/$(database)/documents/delivery_requests/$(request.resource.data.mission_id)).data) ||
          get(/databases/$(database)/documents/delivery_requests/$(request.resource.data.mission_id)).data.assignment_mode != 'internal_test'
        ) &&
        (
          (get(/databases/$(database)/documents/delivery_requests/$(request.resource.data.mission_id)).data.customer_id == uid() &&
           request.resource.data.rater_role == 'customer') ||
          (get(/databases/$(database)/documents/delivery_requests/$(request.resource.data.mission_id)).data.driver_id == uid() &&
           request.resource.data.rater_role == 'driver')
        );

      allow update: if false; // immuable après création
      allow delete: if isAdminOrAbove(); // modération uniquement
    }

    // -------------------------------------------------------------------
    // users/{uid}/notifications/{notificationId}
    //
    // 🔒 CHEMIN CANONIQUE (Phase 5, partie 3) — CORRIGÉ.
    // Cette règle contenait auparavant un segment `items` en trop
    // (`users/{userId}/notifications/items/{notificationId}`, 5 segments —
    // un nombre IMPAIR ne pouvant JAMAIS matcher un document Firestore réel,
    // l'alternance collection/document exigeant un nombre pair de segments).
    // Cette règle n'avait donc jamais pu s'appliquer à un document existant,
    // et les Cloud Functions qui écrivaient par ailleurs dans une collection
    // racine `notifications/{uid}/items` (chemin différent) créaient des
    // documents totalement dépourvus de règle de sécurité (illisibles par
    // quiconque, deny-by-default). Corrigé : chemin unique et cohérent —
    // `users/{uid}/notifications/{notificationId}` (4 segments, valide) —
    // utilisé par TOUTES les Cloud Functions créant des notifications
    // (detectExpiringDocuments, transitionFoundingDriverPeriods,
    // onMissionStatusChangeNotifyCustomer).
    // -------------------------------------------------------------------
    match /users/{userId}/notifications/{notificationId} {
      allow read: if isSignedIn() && uid() == userId;
      // Seul is_read peut être modifié par le propriétaire.
      allow update: if isSignedIn() && uid() == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_read']);
      allow create: if false; // 🔒 Cloud Functions only.
      allow delete: if false;
    }

    // -------------------------------------------------------------------
    // admin_reviews/{id}
    // -------------------------------------------------------------------
    match /admin_reviews/{reviewId} {
      allow read, write: if isAnalystOrAbove();
    }

    // -------------------------------------------------------------------
    // audit_logs/{id} — IMMUABLE, lecture admin/super_admin uniquement
    // -------------------------------------------------------------------
    match /audit_logs/{logId} {
      allow read: if isAdminOrAbove();
      allow write: if false; // 🔒 Cloud Functions only.
    }

    // -------------------------------------------------------------------
    // DENY BY DEFAULT — tout le reste est bloqué.
    // -------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
